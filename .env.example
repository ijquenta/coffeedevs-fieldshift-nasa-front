# Backend base URL. Used only when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_BASE_URL=https://yanapiri-backend-production.up.railway.app/

# true uses deterministic wizard mock services; false calls /diagnostico, /sugerencias and /chat.
NEXT_PUBLIC_USE_MOCK=false

# Maximum field area accepted by the prediction form (hectares).
NEXT_PUBLIC_MAX_PREDICTION_AREA_HA=1000
NEXT_PUBLIC_MIN_PARCEL_HA=0.01

# Optional Cesium Ion access token. Leave unset to keep Cesium's default token.
# NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Optional contact for the public Nominatim geocoder (recommended for production deployments).
# GEOCODER_CONTACT_EMAIL=equipo@ejemplo.org
